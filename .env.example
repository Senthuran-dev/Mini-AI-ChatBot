# Groq API Key — get yours free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# (Recommended) Tavily API key for live web search — free tier: 1,000 credits/month (each search here costs 1)
# Get one at https://app.tavily.com
# Leave it empty and the bot falls back to DuckDuckGo (no key needed, but less reliable).
TAVILY_API_KEY=

# (Optional) Override the Groq model. Default: openai/gpt-oss-20b
# Models: https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-120b
